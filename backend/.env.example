# Project Builder Environment Configuration
APP_NAME="Project Builder"
APP_ENV=development
LOG_LEVEL=INFO

# Security (Change in production)
JWT_SECRET=super-secret-development-token-key-32chars
ACCESS_TOKEN_MINUTES=720
BCRYPT_ROUNDS=12

# Default Admin Credentials (Seeded on first startup)
ADMIN_EMAIL=admin@projectbuilder.dev
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Platform Administrator

# Database (SQLite by default; or postgresql+psycopg://user:password@localhost/project_builder)
DATABASE_URL=sqlite:///./data/project_builder.db

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generative AI / Hybrid LLM (Optional - works 100% offline without keys)
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT=30

# File Storage
STORAGE_BACKEND=local
MAX_UPLOAD_MB=15
